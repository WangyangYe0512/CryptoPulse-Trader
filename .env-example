# This is an example .env file for the CryptoPulse Trader.
# Copy this file to .env and fill in your actual API keys and preferred settings.
# Lines starting with # are comments and will be ignored.

# --- Binance API Configuration ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Telegram Notification Configuration ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trading Parameters (Overrides config.yaml if set here) ---
# PER_ORDER_SIZE_USDT=100.0
# MAX_ORDERS_PER_SYMBOL=3
# MAX_ACTIVE_SYMBOLS=5
# ADD_POSITION_INTERVAL_MINUTES=30 # Renamed from ADD_POSITION_INTERVAL
# MAX_DAILY_LOSS_PERCENT=5.0
# MAX_HOLDING_TIME_MINUTES=60
# STOP_LOSS_PERCENT=1.0
# TAKE_PROFIT_PERCENT=2.0

# --- System Behavior (Overrides config.yaml if set here) ---
# SCAN_INTERVAL_SECONDS=3600
# CHECK_INTERVAL_SECONDS=60

# --- Logging Configuration (Overrides config.yaml if set here) ---
LOG_LEVEL=INFO
# LOG_FILE=logs/trading.log

# --- Database Configuration (SQLite - Overrides config.yaml if set here) ---
# DB_ENABLED=false
# DB_TYPE=sqlite
# DB_PATH=data/
# DB_FILENAME=trading_data.sqlite

# 交易配置
MAX_POSITION_SIZE=100.0
MAX_DAILY_LOSS=5.0
MAX_HOLDING_TIME=60
STOP_LOSS_PCT=1.0
TAKE_PROFIT_PCT=2.0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# 数据库配置
DB_HOST=localhost
DB_PORT=27017
DB_NAME=trading_db 